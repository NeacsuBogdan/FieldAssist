{
  "name": "@fieldassist/api",
  "private": true,
  "type": "module",
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "build": "tsc -p tsconfig.build.json",
    "predb:seed": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint \"{src,prisma,test}/**/*.ts\"",
    "prebuild": "pnpm --filter @fieldassist/shared build && prisma generate",
    "predev": "pnpm --filter @fieldassist/shared build && prisma generate",
    "pretest": "pnpm --filter @fieldassist/shared build && prisma generate",
    "pretypecheck": "pnpm --filter @fieldassist/shared build && prisma generate",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/sensible": "^6.0.3",
    "@fieldassist/shared": "workspace:*",
    "@prisma/client": "^6.16.2",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.1",
    "fastify-type-provider-zod": "^6.1.0",
    "socket.io": "^4.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.3",
    "prisma": "^6.16.2",
    "tsx": "^4.19.3",
    "vitest": "^4.0.18"
  }
}
