{
  "name": "@fieldassist/web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "prebuild": "pnpm --filter @fieldassist/shared build",
