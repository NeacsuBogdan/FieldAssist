{
  "name": "fieldassist",
  "private": true,
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm -r --parallel --if-present dev",
    "db:generate": "pnpm --filter @fieldassist/api db:generate",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "test:e2e": "echo \"E2E coverage is added in Stage 8.\"",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @fieldassist/api db:migrate",
    "db:migrate:dev": "pnpm --filter @fieldassist/api db:migrate:dev",
    "db:seed": "pnpm --filter @fieldassist/api db:seed",
    "db:up": "docker compose up -d postgres"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1"
  }
}
